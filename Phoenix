	bubbles.Lifetime = NumberRange.new(0.8, 1.5)
	bubbles.Rate = 45
	bubbles.Speed = NumberRange.new(2, 4)
	bubbles.Acceleration = Vector3.new(0, 6, 0)
	bubbles.Parent = liquid

	local flaskLight = Instance.new("PointLight")
	flaskLight.Name = "FlaskLight"
	flaskLight.Color = Color3.fromRGB(50, 255, 50)
	flaskLight.Brightness = 5
	flaskLight.Range = 18
	flaskLight.Parent = liquid

	local ring2 = Instance.new("Part")
	ring2.Name = "Ring2"
	ring2.Shape = Enum.PartType.Cylinder
	ring2.Size = Vector3.new(0.4, 7.7, 7.7)
	ring2.CFrame = CFrame.new(targetPos + Vector3.new(0, 8.3, 0)) * rot
	ring2.Anchored = true
	ring2.CanCollide = false
	ring2.BrickColor = BrickColor.new("Black")
	ring2.Material = Enum.Material.SmoothPlastic
	ring2.Parent = flask

	local topCap = Instance.new("Part")
	topCap.Name = "TopCap"
	topCap.Shape = Enum.PartType.Cylinder
	topCap.Size = Vector3.new(1.2, 7.2, 7.2)
