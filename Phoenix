			if oldFlask.Clone then oldFlask.Clone:Destroy() end
		end
	end

	local flask = Instance.new("Model")
	flask.Name = "PhoenixFlask"
	flask.Parent = Workspace

	local rot = CFrame.Angles(0, 0, math.rad(90))

	local base = Instance.new("Part")
