--------------------------------------------------------------------------------
-- 4. ОБРАБОТКА СМЕРТИ И АВТО-ВЫБОР РАНДОМНОЙ КАПСУЛЫ ЧЕРЕЗ 3 СЕКУНДЫ
--------------------------------------------------------------------------------
local function cancelAutoSpawnTimer()
	if autoSpawnConnection then
		task.cancel(autoSpawnConnection)
		autoSpawnConnection = nil
	end
end

local function updateMenuButtons()
	for _, child in ipairs(buttonsContainer:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for i, flaskData in ipairs(activeFlasks) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 140, 0, 70)
		btn.BackgroundColor3 = Color3.fromRGB(0, 200, 80) -- Зелёный цвет кнопок
		btn.Text = "Капсула #" .. i
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.TextSize = 18
		btn.Font = Enum.Font.GothamBold
		btn.ZIndex = 52
		
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = btn

		btn.MouseButton1Click:Connect(function()
			cancelAutoSpawnTimer()
			blockStandardSpawn = false
			chosenFlaskIndex = i
			isRespawningFromFlask = true
			selectMenu.Visible = false

			player:LoadCharacter()
		end)

		btn.Parent = buttonsContainer
	end
end

local function setupCharacter(char)
	local humanoid = char:WaitForChild("Humanoid")
	
	humanoid.Died:Connect(function()
		if #activeFlasks == 0 then
			selectMenu.Visible = false
			blockStandardSpawn = false
			return
		end

		isRespawningFromFlask = false
		blockStandardSpawn = true
		updateMenuButtons()
		selectMenu.Visible = true

		-- Таймер авто-выбора рандомной капсулы через 3 секунды
		cancelAutoSpawnTimer()
		autoSpawnConnection = task.delay(3, function()
			if selectMenu.Visible and #activeFlasks > 0 then
				local randomIndex = math.random(1, #activeFlasks)
				chosenFlaskIndex = randomIndex
				isRespawningFromFlask = true
				selectMenu.Visible = false
				blockStandardSpawn = false
				player:LoadCharacter()
			end
		end)
	end)
end

Players.LocalPlayer.CharacterAdded:Connect(function(newChar)
	cancelAutoSpawnTimer()
	local humanoid = newChar:WaitForChild("Humanoid")
	local rootPart = newChar:WaitForChild("HumanoidRootPart")

	if blockStandardSpawn and not isRespawningFromFlask then
		selectMenu.Visible = false
		blockStandardSpawn = false
		setupCharacter(newChar)
		return
	end

	if not isRespawningFromFlask then
		selectMenu.Visible = false
		setupCharacter(newChar)
		return
	end

	if activeFlasks[chosenFlaskIndex] then
		local flaskData = activeFlasks[chosenFlaskIndex]
		
		if flaskData.Clone then
			flaskData.Clone:Destroy()
			flaskData.Clone = nil
		end

		local flaskModel = flaskData.Model
		local flaskPos = flaskData.Position

		if flaskModel and flaskModel:FindFirstChild("Base") then
			local base = flaskModel.Base
			local glass = flaskModel:FindFirstChild("Glass")
			local liquid = flaskModel:FindFirstChild("Liquid")
			local topCap = flaskModel:FindFirstChild("TopCap")
			local ring1 = flaskModel:FindFirstChild("Ring1")
			local ring2 = flaskModel:FindFirstChild("Ring2")
			local hiss = base:FindFirstChild("HissSound")
			local light = liquid:FindFirstChild("FlaskLight")

			rootPart.CFrame = CFrame.new(flaskPos.X, flaskPos.Y + 3.8, flaskPos.Z)
			rootPart.Anchored = true
			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0

			local smoke = Instance.new("ParticleEmitter")
			smoke.Name = "PhoenixSmoke"
			smoke.Color = ColorSequence.new(Color3.fromRGB(100, 200, 255))
			smoke.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), 
				NumberSequenceKeypoint.new(0.4, 5.5), 
				NumberSequenceKeypoint.new(1, 13)
			})
			smoke.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.05), 
				NumberSequenceKeypoint.new(0.5, 0.25), 
				NumberSequenceKeypoint.new(1, 1)
			})
			smoke.Lifetime = NumberRange.new(3, 4.5)
			smoke.Rate = 200
			smoke.Speed = NumberRange.new(2, 7)
			smoke.Parent = base

			if hiss then hiss:Play() end

			task.spawn(function()
				if light then
					TweenService:Create(light, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 3, true), {Brightness = 10}):Play()
				end

				local openInfo = TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				if glass and topCap and liquid then
					if ring1 then TweenService:Create(ring1, openInfo, {CFrame = ring1.CFrame + Vector3.new(0, 9.5, 0), Transparency = 1}):Play() end
					if ring2 then TweenService:Create(ring2, openInfo, {CFrame = ring2.CFrame + Vector3.new(0, 9.5, 0), Transparency = 1}):Play() end
					TweenService:Create(glass, openInfo, {CFrame = glass.CFrame + Vector3.new(0, 9.5, 0), Transparency = 1}):Play()
					TweenService:Create(topCap, openInfo, {CFrame = topCap.CFrame + Vector3.new(0, 9.5, 0)}):Play()
					TweenService:Create(liquid, openInfo, {Transparency = 1}):Play()
					
					local bub = liquid:FindFirstChild("Bubbles")
					if bub then bub.Enabled = false end
					
					if light then TweenService:Create(light, TweenInfo.new(1), {Brightness = 0}):Play() end
				end

				task.wait(1.5)
				rootPart.Anchored = false

				task.wait(1.3)
				if hiss then
					local fadeSound = TweenService:Create(hiss, TweenInfo.new(1.2), {Volume = 0})
					fadeSound:Play()
					fadeSound.Completed:Wait()
					hiss:Stop()
					hiss.Volume = 4
				end
				
				smoke:Destroy()
				humanoid.WalkSpeed = 16
				humanoid.JumpPower = 50

				task.delay(4, function()
					if flaskModel and glass and topCap and liquid then
						local closeInfo = TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
						local rot = CFrame.Angles(0, 0, math.rad(90))
						
						if ring1 then TweenService:Create(ring1, closeInfo, {CFrame = CFrame.new(flaskPos + Vector3.new(0, 1.3, 0)) * rot, Transparency = 0}):Play() end
						if ring2 then TweenService:Create(ring2, closeInfo, {CFrame = CFrame.new(flaskPos + Vector3.new(0, 8.3, 0)) * rot, Transparency = 0}):Play() end

						TweenService:Create(glass, closeInfo, {CFrame = CFrame.new(flaskPos + Vector3.new(0, 4.8, 0)) * rot, Transparency = 0.3}):Play()
						TweenService:Create(topCap, closeInfo, {CFrame = CFrame.new(flaskPos + Vector3.new(0, 9.4, 0)) * rot}):Play()
						TweenService:Create(liquid, closeInfo, {Transparency = 0.2}):Play()
						
						local bub = liquid:FindFirstChild("Bubbles")
						if bub then bub.Enabled = true end
						
						if light then light.Brightness = 6 end

						createCloneInsideFlask(flaskData)
					end
				end)
			end)
		end
		isRespawningFromFlask = false
	end

	setupCharacter(newChar)
end)

if player.Character then
	setupCharacter(player.Character)
end


