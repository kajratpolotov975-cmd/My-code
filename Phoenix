-- 2. СОЗДАНИЕ КЛОНА ВНУТРИ КОЛБЫ (ПРЕВЬЮ)
--------------------------------------------------------------------------------
local function createCloneInsideFlask(flaskData)
	if flaskData.Clone then
		flaskData.Clone:Destroy()
		flaskData.Clone = nil
	end

	task.spawn(function()
		pcall(function()
			local model = Players:CreateHumanoidModelFromUserId(player.UserId)
			if model then
				model.Name = "FlaskClone"
				
				local root = model:FindFirstChild("HumanoidRootPart")
				if root then
					root.CFrame = CFrame.new(flaskData.Position.X, flaskData.Position.Y + 3.8, flaskData.Position.Z)
					root.Anchored = true
				end

				for _, child in ipairs(model:GetDescendants()) do
					if child:IsA("Script") or child:IsA("LocalScript") then
						child:Destroy()
					end
				end

				local hum = model:FindFirstChildOfClass("Humanoid")
				if hum then
					local animator = hum:FindFirstChildOfClass("Animator")
					if animator then animator:Destroy() end
				end

				model.Parent = Workspace
				flaskData.Clone = model
			end
		end)
	end)
end

