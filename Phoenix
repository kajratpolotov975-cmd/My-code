	end
end)

--------------------------------------------------------------------------------
-- 4. ЛОГИКА СМЕРТИ И РЕСПАУНА
--------------------------------------------------------------------------------
local function setupCharacter(char)
	local humanoid = char:WaitForChild("Humanoid")
	
	humanoid.Died:Connect(function()
		if not spawnFlaskModel or not spawnFlaskModel:FindFirstChild("Base") then return end

		deathScreen.BackgroundTransparency = 0
		deathText.TextTransparency = 0

		for i = 3, 1, -1 do
            deathText.Text = "Активация клона: " .. i
			task.wait(1)
		end

		deathText.Text = "Операция «Феникс»!"
		player:LoadCharacter()
	end)
end

Players.LocalPlayer.CharacterAdded:Connect(function(newChar)
	local humanoid = newChar:WaitForChild("Humanoid")
	local rootPart = newChar:WaitForChild("HumanoidRootPart")

	if cloneModel then
		cloneModel:Destroy()
		cloneModel = nil
	end

	if spawnFlaskModel and spawnFlaskModel:FindFirstChild("Base") then
		local base = spawnFlaskModel.Base
		local glass = spawnFlaskModel:FindFirstChild("Glass")
		local liquid = spawnFlaskModel:FindFirstChild("Liquid")
		local topCap = spawnFlaskModel:FindFirstChild("TopCap")
		local ring1 = spawnFlaskModel:FindFirstChild("Ring1")
		local ring2 = spawnFlaskModel:FindFirstChild("Ring2")
		local hiss = base:FindFirstChild("HissSound")
		local light = liquid:FindFirstChild("FlaskLight")

		rootPart.CFrame = CFrame.new(flaskPosition.X, flaskPosition.Y + 3.8, flaskPosition.Z)
		rootPart.Anchored = true
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0

		local smoke = Instance.new("ParticleEmitter")
		smoke.Name = "PhoenixSmoke"
		smoke.Color = ColorSequence.new(Color3.fromRGB(180, 255, 150))
		smoke.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), 
			NumberSequenceKeypoint.new(0.4, 5.5), 
			NumberSequenceKeypoint.new(1, 13)
		})
		smoke.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05), 
			NumberSequenceKeypoint.new(0.5, 0.25), 
			NumberSequenceKeypoint.new(1, 1)
		})
		smoke.Lifetime = NumberRange.new(3, 4.5)
		smoke.Rate = 200
		smoke.Speed = NumberRange.new(2, 7)
		smoke.Parent = base

		if hiss then hiss:Play() end

		task.wait(0.6)

		TweenService:Create(deathScreen, TweenInfo.new(0.6), {BackgroundTransparency = 1}):Play()
		TweenService:Create(deathText, TweenInfo.new(0.6), {TextTransparency = 1}):Play()

		if light then
			TweenService:Create(light, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 3, true), {Brightness = 8}):Play()
		end

		local openInfo = TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		if glass and topCap and liquid then
			if ring1 then TweenService:Create(ring1, openInfo, {CFrame = ring1.CFrame + Vector3.new(0, 9.5, 0), Transparency = 1}):Play() end
			if ring2 then TweenService:Create(ring2, openInfo, {CFrame = ring2.CFrame + Vector3.new(0, 9.5, 0), Transparency = 1}):Play() end
			TweenService:Create(glass, openInfo, {CFrame = glass.CFrame + Vector3.new(0, 9.5, 0), Transparency = 1}):Play()
			TweenService:Create(topCap, openInfo, {CFrame = topCap.CFrame + Vector3.new(0, 9.5, 0)}):Play()
			TweenService:Create(liquid, openInfo, {Transparency = 1}):Play()
			
			local bub = liquid:FindFirstChild("Bubbles")
			if bub then bub.Enabled = false end
			
			if light then TweenService:Create(light, TweenInfo.new(1), {Brightness = 0}):Play() end
		end

		task.wait(1.5)
		rootPart.Anchored = false

		task.wait(1.3)
		if hiss then
			local fadeSound = TweenService:Create(hiss, TweenInfo.new(1.2), {Volume = 0})
			fadeSound:Play()
			fadeSound.Completed:Wait()
			hiss:Stop()
			hiss.Volume = 4
		end
		
		smoke:Destroy()
		humanoid.WalkSpeed = 16
		humanoid.JumpPower = 50

		task.delay(4, function()
			if spawnFlaskModel and glass and topCap and liquid then
				local closeInfo = TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				local rot = CFrame.Angles(0, 0, math.rad(90))
				
				if ring1 then TweenService:Create(ring1, closeInfo, {CFrame = CFrame.new(flaskPosition + Vector3.new(0, 1.3, 0)) * rot, Transparency = 0}):Play() end
				if ring2 then TweenService:Create(ring2, closeInfo, {CFrame = CFrame.new(flaskPosition + Vector3.new(0, 8.3, 0)) * rot, Transparency = 0}):Play() end

				TweenService:Create(glass, closeInfo, {CFrame = CFrame.new(flaskPosition + Vector3.new(0, 4.8, 0)) * rot, Transparency = 0.25}):Play()
				TweenService:Create(topCap, closeInfo, {CFrame = CFrame.new(flaskPosition + Vector3.new(0, 9.4, 0)) * rot}):Play()
				TweenService:Create(liquid, closeInfo, {Transparency = 0.15}):Play()
				
				local bub = liquid:FindFirstChild("Bubbles")
				if bub then bub.Enabled = true end
				
				if light then light.Brightness = 5 end

				createCloneInsideFlask(flaskPosition)
			end
		end)
	else
		TweenService:Create(deathScreen, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
		TweenService:Create(deathText, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
	end

	setupCharacter(newChar)
end)

if player.Character then
	setupCharacter(player.Character)
end

