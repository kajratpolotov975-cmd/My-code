local function createFlask(targetPos)
	if spawnFlaskModel then
		spawnFlaskModel:Destroy()
		spawnFlaskModel = nil
	end

	flaskPosition = targetPos

	local flask = Instance.new("Model")
	flask.Name = "RickFlask"
	flask.Parent = Workspace

	local rot = CFrame.Angles(0, 0, math.rad(90))

	local base = Instance.new("Part")
	base.Name = "Base"
	base.Shape = Enum.PartType.Cylinder
	base.Size = Vector3.new(1.2, 7.5, 7.5)
	base.CFrame = CFrame.new(targetPos + Vector3.new(0, 0.6, 0)) * rot
	base.Anchored = true
	base.CanCollide = true
	base.BrickColor = BrickColor.new("Dark stone grey")
	base.Material = Enum.Material.Metal
	base.Parent = flask

	local ring1 = Instance.new("Part")
	ring1.Name = "Ring1"
	ring1.Shape = Enum.PartType.Cylinder
	ring1.Size = Vector3.new(0.4, 7.7, 7.7)
	ring1.CFrame = CFrame.new(targetPos + Vector3.new(0, 1.3, 0)) * rot
	ring1.Anchored = true
	ring1.CanCollide = true
	ring1.BrickColor = BrickColor.new("Black")
	ring1.Material = Enum.Material.SmoothPlastic
	ring1.Parent = flask

	local glass = Instance.new("Part")
	glass.Name = "Glass"
	glass.Shape = Enum.PartType.Cylinder
	glass.Size = Vector3.new(8.5, 6.8, 6.8)
	glass.CFrame = CFrame.new(targetPos + Vector3.new(0, 4.8, 0)) * rot
	glass.Anchored = true
	glass.CanCollide = false
	glass.Transparency = 0.25
	glass.BrickColor = BrickColor.new("Mint")
	glass.Material = Enum.Material.Glass
