	local backRedPanel = Instance.new("Part")
	backRedPanel.Size = Vector3.new(0.83, 0.45, 0.05)
	backRedPanel.Color = Color3.fromRGB(220, 30, 30)
	backRedPanel.Material = Enum.Material.SmoothPlastic
	attach(backRedPanel, CFrame.new(0, 0, 0.78))

	local screenDisp = Instance.new("Part")
	screenDisp.Size = Vector3.new(0.45, 0.24, 0.02)
	screenDisp.Color = Color3.fromRGB(20, 20, 20)
	screenDisp.Material = Enum.Material.SmoothPlastic
	attach(screenDisp, CFrame.new(0, 0.03, 0.80))

	local screenGui = Instance.new("SurfaceGui")
	screenGui.Face = Enum.NormalId.Back
	screenGui.Parent = screenDisp

	local screenText = Instance.new("TextLabel")
	screenText.Size = UDim2.new(1, 0, 1, 0)
	screenText.BackgroundTransparency = 1
	screenText.Text = "C-137"
	screenText.TextColor3 = Color3.fromRGB(50, 255, 50)
	screenText.TextScaled = true
	screenText.Font = Enum.Font.Code
	screenText.Parent = screenGui

	local sticker = Instance.new("Part")
	sticker.Size = Vector3.new(0.01, 0.28, 0.9)
	sticker.Color = Color3.fromRGB(150, 230, 150)
	sticker.Material = Enum.Material.SmoothPlastic
	attach(sticker, CFrame.new(-0.43, 0.02, 0.0))

	local stickerGui = Instance.new("SurfaceGui")
	stickerGui.Face = Enum.NormalId.Left
	stickerGui.Parent = sticker

	local stickerText = Instance.new("TextLabel")
	stickerText.Size = UDim2.new(0.95, 0, 0.85, 0)
	stickerText.Position = UDim2.new(0.025, 0, 0.075, 0)
	stickerText.BackgroundTransparency = 1
	stickerText.RichText = true
	stickerText.Text = '<font color="#FFFF00">P</font><font color="#FFA500">o</font><font color="#FF4500">r</font><font color="#FF69B4">t</font><font color="#DA70D6">a</font><font color="#8A2BE2">l</font> <font color="#00FFFF">g</font><font color="#7FFF00">u</font><font color="#FFFF00">n</font> <font color="#FF1493">j</font><font color="#00FF7F">r</font>'
	stickerText.TextScaled = true
	stickerText.Font = Enum.Font.FredokaOne
	stickerText.Parent = stickerGui

	portalGun.Activated:Connect(function()
		local mouse = LocalPlayer:GetMouse()
		local ray = Workspace:Raycast(mouse.UnitRay.Origin, mouse.UnitRay.Direction * 500)
		if not ray then return end

		-- Звук выстрела пушки теперь обычный (без ускорений)
		playSoundSafe(756847338, 1.2, 1.0)

		local hitPos = ray.Position
		local normal = ray.Normal
		drawLaserBeam(shootPoint.Position, hitPos)

		local adjustedPos = hitPos + (normal * 0.05)
		local portalCFrame = CFrame.lookAt(adjustedPos, adjustedPos + normal) * CFrame.Angles(0, math.rad(90), 0)

		if currentPortalIndex == 1 then
			if portal1 then portal1:Destroy() end
			portal1 = createPortalFX()
			portal1:SetPrimaryPartCFrame(portalCFrame)
			portal1.Parent = workspace

			setupTeleport(portal1, portal2)
			if portal2 then setupTeleport(portal2, portal1) end
			currentPortalIndex = 2
		else
			if portal2 then portal2:Destroy() end
			portal2 = createPortalFX()
			portal2:SetPrimaryPartCFrame(portalCFrame)
			portal2.Parent = workspace

			setupTeleport(portal2, portal1)
			setupTeleport(portal1, portal2)
			currentPortalIndex = 1
		end
	end)

	return portalGun
end

