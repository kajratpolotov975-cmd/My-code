-- 1. ЭФФЕКТЫ И ЭКРАН
local flashGui = Instance.new("ScreenGui")
flashGui.Name = "PortalFXGui"
flashGui.ResetOnSpawn = false
flashGui.IgnoreGuiInset = true
flashGui.Parent = playerGui

local flashFrame = Instance.new("Frame")
flashFrame.Size = UDim2.new(1, 0, 1, 0)
flashFrame.BackgroundColor3 = Color3.fromRGB(40, 220, 70)
flashFrame.BackgroundTransparency = 1
flashFrame.BorderSizePixel = 0
flashFrame.Parent = flashGui

local portalBlur = Instance.new("BlurEffect")
portalBlur.Size = 0
portalBlur.Enabled = true
portalBlur.Parent = Lighting

local function playSoundSafe(id, volume, pitch, parent)
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. tostring(id)
	s.Volume = volume or 1
	s.Pitch = pitch or 1
	s.Parent = parent or Workspace
	
	task.spawn(function()
		local success = pcall(function() s:Play() end)
		if success then
			s.Ended:Wait()
		end
		s:Destroy()
	end)
end

-- Эффект при входе/выходе (быстрый вход, замедленный плавный выход)
local function playPortalScreenEffect()
	-- Звук телепортации (оригинальный из Рик и Морти)
	playSoundSafe(756847338, 1.2, 1.0)
	
	-- Быстрое появление зелёной пелены при входе (0.12 сек)
	flashFrame.BackgroundTransparency = 1
	local tweenIn = TweenService:Create(flashFrame, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {BackgroundTransparency = 0.25})
	local blurIn = TweenService:Create(portalBlur, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = 28})
	
	tweenIn:Play()
	blurIn:Play()
	
	-- Долгое, замедленное и плавное затухание при выходе (1.1 секунды)
	task.delay(0.15, function()
		local tweenOut = TweenService:Create(flashFrame, TweenInfo.new(1.1, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {BackgroundTransparency = 1})
		local blurOut = TweenService:Create(portalBlur, TweenInfo.new(1.1, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Size = 0})
		tweenOut:Play()
		blurOut:Play()
	end)
end

-- 2. ЛУЧ ВЫСТРЕЛА
local function drawLaserBeam(startPos, endPos)
	local distance = (startPos - endPos).Magnitude
	local beam = Instance.new("Part")
	beam.Size = Vector3.new(0.2, 0.2, distance)
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(80, 255, 80)
	beam.Anchored = true
	beam.CanCollide = false
	beam.CFrame = CFrame.new(startPos:Lerp(endPos, 0.5), endPos)
	beam.Parent = workspace

	local tween = TweenService:Create(beam, TweenInfo.new(0.25), {
		Transparency = 1,
		Size = Vector3.new(0.01, 0.01, distance)
	})
	tween:Play()
	tween.Completed:Connect(function() beam:Destroy() end)
end

