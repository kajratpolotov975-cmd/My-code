	if portal2 then portal2:Destroy() portal2 = nil end
	currentPortalIndex = 1
end

-- ТЕЛЕПОРТАЦИЯ С ПРЫЖКОМ
local function setupTeleport(srcModel, tgtModel)
	if not srcModel or not tgtModel then return end
	local src = srcModel.PrimaryPart
	local tgt = tgtModel.PrimaryPart

	src.Touched:Connect(function(hit)
		if isTeleporting or not tgt or not tgt.Parent then return end
		local char = hit.Parent
		if not char or char ~= LocalPlayer.Character then return end
		
		local root = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")

		if hum and root and hum.Health > 0 then
			isTeleporting = true
			playPortalScreenEffect()

			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero

			local normal = tgt.CFrame.RightVector
			local isFloor = math.abs(normal.Y) > 0.6
			
			local targetPos
			local forwardDir

			if isFloor then
				targetPos = tgt.Position + Vector3.new(0, 2, 0)
				local currentLook = root.CFrame.LookVector
				forwardDir = Vector3.new(currentLook.X, 0, currentLook.Z)
				if forwardDir.Magnitude < 0.1 then forwardDir = Vector3.new(0, 0, -1) else forwardDir = forwardDir.Unit end
			else
				targetPos = tgt.Position + (normal * 2.5) + Vector3.new(0, 0.5, 0)
				forwardDir = Vector3.new(normal.X, 0, normal.Z)
				if forwardDir.Magnitude < 0.1 then forwardDir = Vector3.new(0, 0, -1) else forwardDir = forwardDir.Unit end
			end

			char:PivotTo(CFrame.lookAt(targetPos, targetPos + forwardDir))

			task.defer(function()
				task.wait()
				if hum and hum.Health > 0 then
					hum.Jump = true
				end
			end)

			task.wait(0.3)
			isTeleporting = false
		end
	end)
end

-- 4. СБОРКА ПУШКИ (12 ШАРИКОВ В КУПОЛЕ)
local function buildPortalGun()
	local portalGun = Instance.new("Tool")
	portalGun.Name = "Portal gun jr"
	portalGun.RequiresHandle = true
	portalGun.CanBeDropped = false

	portalGun.Grip = CFrame.new(0, -0.3, 0.3)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.85, 0.5, 1.6)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.Parent = portalGun

	local gunModel = Instance.new("Model")
	gunModel.Name = "RickPortalGunModel"
	gunModel.Parent = portalGun

	local function attach(part, offsetCFrame)
		part.CanCollide = false
		part.Massless = true
		part.CFrame = handle.CFrame * offsetCFrame
		part.Parent = gunModel
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = part
		weld.Parent = handle
	end

	local body = Instance.new("Part")
	body.Size = Vector3.new(0.85, 0.5, 1.6)
	body.Color = Color3.fromRGB(220, 222, 228)
	body.Material = Enum.Material.SmoothPlastic
	attach(body, CFrame.new(0, 0, 0))

	local frontFace = Instance.new("Part")
	frontFace.Size = Vector3.new(0.83, 0.45, 0.06)
	frontFace.Color = Color3.fromRGB(180, 185, 195)
	frontFace.Material = Enum.Material.SmoothPlastic
	attach(frontFace, CFrame.new(0, 0.05, -0.81) * CFrame.Angles(math.rad(25), 0, 0))

	local grip = Instance.new("Part")
	grip.Shape = Enum.PartType.Cylinder
	grip.Size = Vector3.new(0.65, 0.38, 0.38)
	grip.Color = Color3.fromRGB(30, 120, 215)
	grip.Material = Enum.Material.SmoothPlastic
	attach(grip, CFrame.new(0, -0.38, 0.3) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(math.rad(-12), 0, 0))

	local shootPoint = Instance.new("Part")
	shootPoint.Name = "ShootPoint"
	shootPoint.Size = Vector3.new(0.1, 0.1, 0.1)
	shootPoint.Transparency = 1
	attach(shootPoint, CFrame.new(0, 0.05, -0.9))

	local clownNose = Instance.new("Part")
	clownNose.Shape = Enum.PartType.Ball
	clownNose.Size = Vector3.new(0.22, 0.22, 0.22)
	clownNose.Color = Color3.fromRGB(235, 30, 30)
	clownNose.Material = Enum.Material.SmoothPlastic
	attach(clownNose, CFrame.new(0, -0.04, -0.85) * CFrame.Angles(math.rad(25), 0, 0))

	local eyeLeftBase = Instance.new("Part")
	eyeLeftBase.Shape = Enum.PartType.Cylinder
	eyeLeftBase.Size = Vector3.new(0.08, 0.18, 0.18)
	eyeLeftBase.Color = Color3.fromRGB(100, 105, 115)
	eyeLeftBase.Material = Enum.Material.Metal
	attach(eyeLeftBase, CFrame.new(-0.24, 0.14, -0.85) * CFrame.Angles(math.rad(25), math.rad(90), 0))

	local eyeLeftLens = Instance.new("Part")
	eyeLeftLens.Shape = Enum.PartType.Cylinder
	eyeLeftLens.Size = Vector3.new(0.09, 0.12, 0.12)
	eyeLeftLens.Color = Color3.fromRGB(80, 220, 255)
	eyeLeftLens.Material = Enum.Material.Neon
	attach(eyeLeftLens, CFrame.new(-0.24, 0.14, -0.86) * CFrame.Angles(math.rad(25), math.rad(90), 0))

	local eyeRightBase = Instance.new("Part")
	eyeRightBase.Shape = Enum.PartType.Cylinder
	eyeRightBase.Size = Vector3.new(0.08, 0.18, 0.18)
	eyeRightBase.Color = Color3.fromRGB(100, 105, 115)
	eyeRightBase.Material = Enum.Material.Metal
	attach(eyeRightBase, CFrame.new(0.24, 0.14, -0.85) * CFrame.Angles(math.rad(25), math.rad(90), 0))

	local eyeRightLens = Instance.new("Part")
	eyeRightLens.Shape = Enum.PartType.Cylinder
	eyeRightLens.Size = Vector3.new(0.09, 0.12, 0.12)
	eyeRightLens.Color = Color3.fromRGB(80, 220, 255)
	eyeRightLens.Material = Enum.Material.Neon
	attach(eyeRightLens, CFrame.new(0.24, 0.14, -0.86) * CFrame.Angles(math.rad(25), math.rad(90), 0))

	local ringBorder = Instance.new("Part")
	ringBorder.Shape = Enum.PartType.Cylinder
	ringBorder.Size = Vector3.new(0.05, 0.48, 0.48)
	ringBorder.Color = Color3.fromRGB(220, 30, 30)
	ringBorder.Material = Enum.Material.SmoothPlastic
	attach(ringBorder, CFrame.new(0, 0.27, -0.3) * CFrame.Angles(0, 0, math.rad(90)))

	local glassDome = Instance.new("Part")
	glassDome.Name = "RickDome"
	glassDome.Shape = Enum.PartType.Ball
	glassDome.Size = Vector3.new(0.52, 0.52, 0.52)
	glassDome.Color = Color3.fromRGB(180, 245, 200)
	glassDome.Material = Enum.Material.Glass
	glassDome.Transparency = 0.45
	attach(glassDome, CFrame.new(0, 0.35, -0.3))

	local bigGreenOrb = Instance.new("Part")
	bigGreenOrb.Name = "InnerEnergyOrb"
	bigGreenOrb.Shape = Enum.PartType.Ball
	bigGreenOrb.Size = Vector3.new(0.28, 0.28, 0.28)
	bigGreenOrb.Color = Color3.fromRGB(60, 255, 60)
	bigGreenOrb.Material = Enum.Material.Neon
	bigGreenOrb.Transparency = 0.15
	attach(bigGreenOrb, CFrame.new(0, 0.35, -0.3))

	-- Создаем 12 шариков ВНУТРИ стеклянного купола
	local smallOrbs = {}
	for i = 1, 12 do
		local orb = Instance.new("Part")
		orb.Shape = Enum.PartType.Ball
		orb.Size = Vector3.new(0.08, 0.08, 0.08)
		orb.Color = Color3.fromRGB(90, 255, 80)
		orb.Material = Enum.Material.Neon
		orb.CanCollide = false
		orb.Massless = true
		orb.Parent = gunModel
		
		local offset = CFrame.new(
			(math.random() - 0.5) * 0.18,
			0.35 + (math.random() - 0.5) * 0.18,
			-0.3 + (math.random() - 0.5) * 0.18
		)
		table.insert(smallOrbs, {
			Part = orb, 
			Offset = offset, 
			Angle = math.random() * math.pi * 2,
			Speed = math.random(3, 7)
		})
	end

	-- Анимация вращения шариков
	local hbConn
	hbConn = RunService.RenderStepped:Connect(function(dt)
		if not portalGun.Parent or not handle.Parent then
			if hbConn then hbConn:Disconnect() end
			return
		end
		for _, data in ipairs(smallOrbs) do
			if data.Part and data.Part.Parent then
				data.Angle = data.Angle + dt * data.Speed
				local radius = 0.1
				local xOffset = math.cos(data.Angle) * radius
				local zOffset = math.sin(data.Angle) * radius
				data.Part.CFrame = handle.CFrame * (data.Offset + Vector3.new(xOffset, 0, zOffset))
			end
		end
	end)

	local yellowBtn = Instance.new("Part")
	yellowBtn.Shape = Enum.PartType.Cylinder
