-- === НАСТРОЙКИ (ФИНАЛЬНЫЕ) ===
local EYE_X = 0.10
local EYE_Y = 0.23
local EYE_Z = -0.60

local EYE_MOVE_Z = -0.35
local RANGE = 3000
local COOLDOWN = 1.2

local laserOn = false
local lastShot = 0
