local function clearOldItems()
	local char = LocalPlayer.Character
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:WaitForChild("Backpack")
	for _, c in ipairs({bp, char}) do
		if c then
			for _, item in ipairs(c:GetChildren()) do
				if item:IsA("Tool") and item.Name == "EvilMortyPortalGun" then item:Destroy() end
			end
		end
	end
	portalTool, toolHandle, gunSound = nil, nil, nil
end
