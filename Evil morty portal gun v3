local touchStartPos, touchStartTime = nil, 0
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType == Enum.UserInputType.Touch then
		touchStartPos = Vector2.new(input.Position.X, input.Position.Y)
		touchStartTime = os.clock()
	end
end)
UserInputService.InputEnded:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType == Enum.UserInputType.Touch and touchStartPos then
		local endPos = Vector2.new(input.Position.X, input.Position.Y)
		local moved = (endPos - touchStartPos).Magnitude
		local dt = os.clock() - touchStartTime
		if moved < 20 and dt < 0.5 then
			local res = raycastFromScreen(touchStartPos.X, touchStartPos.Y)
			if res then placePortalFromRay(res) end
		end
		touchStartPos = nil
	end
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local mp = UserInputService:GetMouseLocation()
		local res = raycastFromScreen(mp.X, mp.Y)
		if res then placePortalFromRay(res) end
	end
end)

