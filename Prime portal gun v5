local function buildGun()
	local t = Instance.new("Tool")
	t.Name = "PortalGun"
	t.RequiresHandle = true
	t.CanBeDropped = false
	t.Grip = CFrame.new(GRIP_X, GRIP_Y, GRIP_Z) * CFrame.Angles(math.rad(ROT_X), math.rad(ROT_Y), math.rad(ROT_Z))
	tool = t

	local h = Instance.new("Part")
	h.Name = "Handle"
	h.Size = Vector3.new(0.5, 0.5, 0.5)
	h.Transparency = 1
	h.CanCollide = false
	h.Massless = true
	h.Parent = t

	local meshPart = Instance.new("Part")
	meshPart.Name = "PortalGunMesh"
	meshPart.Size = Vector3.new(1, 1, 1)
	meshPart.CanCollide = false
	meshPart.Massless = true
	meshPart.Parent = t
	meshPartRef = meshPart

	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = MESH_ID
	mesh.TextureId = TEX_ID
	mesh.Scale = Vector3.new(GUN_SIZE, GUN_SIZE, GUN_SIZE)
	mesh.Parent = meshPart

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = h
	weld.Part1 = meshPart
	weld.Parent = meshPart
	meshPart.CFrame = h.CFrame * CFrame.new(0, 0, -1)

	local gl = Instance.new("PointLight")
	gl.Color = C_GREEN
	gl.Range = 8
	gl.Brightness = 2
	gl.Parent = meshPart

	return t
end

local function giveGun()
	local bp = LP:WaitForChild("Backpack")
	if bp:FindFirstChild("PortalGun") then return end
	buildGun().Parent = bp
end

local function killPortal(p)
	if not p then return end
	if p.Parent then
		if p.Parent:IsA("Model") then p.Parent:Destroy() else p:Destroy() end
	end
end

local function closePortalWithAnim(p)
	if not p or not p.Parent then return end
	local model = p.Parent
	if not model:IsA("Model") then p:Destroy() return end
	local ring
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Part") and d.Shape == Enum.PartType.Cylinder then
			ring = d
			break
		end
	end
	closeSound.TimePosition = 0
	closeSound:Play()
	if ring then
		TweenService:Create(ring, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Size = Vector3.new(0.5, 0.1, 0.1),
			Transparency = 1
		}):Play()
		task.wait(0.35)
	end
	model:Destroy()
end

local function makePortal(pos, norm)
	local model = Instance.new("Model")
	model.Parent = workspace

	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.5, 0.1, 0.1)
	ring.Color = Color3.fromRGB(255, 255, 255)
	ring.Anchored = true
	ring.CanCollide = false

	local up = Vector3.new(0, 1, 0)
	if math.abs(norm.Y) > 0.95 then up = Vector3.new(0, 0, 1) end
	local baseCF = CFrame.lookAt(pos + norm * PORTAL_OFFSET, pos + norm * PORTAL_OFFSET + norm, up) * CFrame.Angles(0, math.rad(-90), 0)
	ring.CFrame = baseCF
	ring.Parent = model

	for _, face in ipairs({Enum.NormalId.Right, Enum.NormalId.Left, Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Front, Enum.NormalId.Back}) do
		local tex = Instance.new("Texture")
		tex.Face = face
		tex.Texture = "rbxassetid://" .. PORTAL_DECAL
		tex.StudsPerTileU = 7
		tex.StudsPerTileV = 7
		tex.Parent = ring
	end

	ring.Size = Vector3.new(0.5, 0.5, 0.5)
	TweenService:Create(ring, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.5, PORTAL_SIZE, PORTAL_SIZE)
	}):Play()

	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Cylinder
	core.Size = Vector3.new(1.5, PORTAL_SIZE * 0.85, PORTAL_SIZE * 0.85)
	core.Transparency = 1
	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = true
	core.CFrame = baseCF
	core.Parent = model

	core:SetAttribute("NX", norm.X)
	core:SetAttribute("NY", norm.Y)
	core:SetAttribute("NZ", norm.Z)

	portalSound.TimePosition = 0
	portalSound:Play()

	local light = Instance.new("PointLight")
	light.Color = C_GREEN
	light.Range = 25
	light.Brightness = 5
	light.Parent = core

	return core
end

local function fireBall(startPos, endPos, norm)
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(BALL_SIZE, BALL_SIZE, BALL_SIZE)
	ball.Color = C_ACID
	ball.Material = Enum.Material.Neon
	ball.Anchored = true
	ball.CanCollide = false
	ball.CFrame = CFrame.new(startPos)
	ball.Parent = workspace

	local ballLight = Instance.new("PointLight")
	ballLight.Color = C_ACID
	ballLight.Range = 15
	ballLight.Brightness = 8
	ballLight.Parent = ball

	local myPortalSide = nextP
	if nextP == "A" then nextP = "B" else nextP = "A" end

	local distance = (endPos - startPos).Magnitude
	local duration = distance / BALL_SPEED
	local startTime = tick()

	local conn
	conn = RunService.Heartbeat:Connect(function()
		if not ball or not ball.Parent then
			if conn then conn:Disconnect() end
			return
		end
		local elapsed = tick() - startTime
		local alpha = math.clamp(elapsed / duration, 0, 1)
		ball.CFrame = CFrame.new(startPos:Lerp(endPos, alpha))
		if alpha >= 1 then
			if conn then conn:Disconnect() end
			conn = nil
			if myPortalSide == "A" then
				killPortal(portalA)
				portalA = nil
				portalA = makePortal(endPos, norm)
			else
				killPortal(portalB)
				portalB = nil
				portalB = makePortal(endPos, norm)
			end
			if ball and ball.Parent then ball:Destroy() end
		end
	end)
end

local function playSuctionEffect(pos)
	for i = 1, 20 do
		local particle = Instance.new("Part")
		particle.Shape = Enum.PartType.Ball
		particle.Size = Vector3.new(0.6, 0.6, 0.6)
		particle.Color = C_ACID
		particle.Material = Enum.Material.Neon
		particle.Anchored = true
		particle.CanCollide = false
		particle.CFrame = CFrame.new(pos + Vector3.new(
			math.random(-8, 8), math.random(-8, 8), math.random(-8, 8)
		))
		particle.Parent = workspace

		local light = Instance.new("PointLight")
		light.Color = C_ACID
		light.Range = 5
		light.Brightness = 5
		light.Parent = particle

		Debris:AddItem(particle, 1.5)

		task.spawn(function()
			local startCF = particle.CFrame
			local targetCF = CFrame.new(pos)
			local t = 0
			while t < 0.6 and particle and particle.Parent do
				t += RunService.RenderStepped:Wait()
				local alpha = t / 0.6
				particle.CFrame = startCF:Lerp(targetCF, alpha)
				particle.Size = Vector3.new(0.6, 0.6, 0.6):Lerp(Vector3.new(0.05, 0.05, 0.05), alpha)
			end
			if particle and particle.Parent then particle:Destroy() end
		end)
	end
end

local function checkTP()
	if isTP then return end
	if os.clock() - tpCD < 1.5 then return end

	local char = LP.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root then return end

	local function inside(p)
		if not p or not p.Parent then return false end
		return (root.Position - p.Position).Magnitude < ENTER_DISTANCE
	end

	local ent, ext
	if portalA and inside(portalA) then ent, ext = portalA, portalB
	elseif portalB and inside(portalB) then ent, ext = portalB, portalA end
	if not ent or not ext or not ext.Parent then return end

	isTP = true
	tpCD = os.clock()

	suckSound.TimePosition = 0
	suckSound.PlaybackSpeed = 1.0
	suckSound:Play()

	task.spawn(playScreenBlur)
	task.spawn(function() playSuctionEffect(ent.Position) end)

	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end

	local targetPos = ent.Position
	local suckTime = tick()
	while tick() - suckTime < 0.4 do
		local alpha = (tick() - suckTime) / 0.4
		alpha = alpha * alpha
		local newPos = root.Position:Lerp(targetPos, alpha)
		root.CFrame = CFrame.new(newPos)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		RunService.RenderStepped:Wait()
	end

	local n = Vector3.new(ext:GetAttribute("NX") or 0, ext:GetAttribute("NY") or 1, ext:GetAttribute("NZ") or 0)
	local ep = ext.Position
	local ip = ep + n * 2.5
	root.CFrame = CFrame.new(ip, ip + n)
	task.spawn(playScreenFlash)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.AssemblyLinearVelocity = (n + Vector3.new(0, 0.6, 0)).Unit * 60 + Vector3.new(0, 30, 0)
	tpSound.TimePosition = 0
	tpSound.PlaybackSpeed = 1.0
	tpSound:Play()

	task.spawn(function()
		task.wait(1.2)
		if hum and hum.Parent then
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
		end
	end)

	task.wait(0.5)
	isTP = false
end

RunService.Heartbeat:Connect(checkTP)

local function shoot()
	if not isGunEquipped() then return end
	if os.clock() - lastShot < 0.3 then return end
	lastShot = os.clock()

	local mouse = LP:GetMouse()
	local origin = cam.CFrame.Position
	local dirVec = mouse.Hit.Position - origin
	if dirVec.Magnitude < 0.01 then return end

	local ignore = {tool}
	if LP.Character then table.insert(ignore, LP.Character) end
	if portalA then table.insert(ignore, portalA) end
	if portalB then table.insert(ignore, portalB) end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then table.insert(ignore, plr.Character) end
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore

	local res = workspace:Raycast(origin, dirVec.Unit * 1000, params)
	if not res then return end

	local hp = res.Position
	local hn = res.Normal

	if meshPartRef then
		local muzzlePos = meshPartRef.Position + meshPartRef.CFrame.LookVector * -1.5
		fireBall(muzzlePos, hp, hn)
	end
end

local touchStartTime = 0
local touchStartPos = Vector2.new(0, 0)
local isTouching = false

UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if not isGunEquipped() then return end
	if input.UserInputType == Enum.UserInputType.Touch then
		touchStartTime = tick()
		touchStartPos = input.Position
		isTouching = true
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		shoot()
	end
end)

UIS.InputEnded:Connect(function(input, gpe)
	if gpe then return end
	if not isTouching then return end
	if input.UserInputType == Enum.UserInputType.Touch then
		if (tick() - touchStartTime) < 0.2 and (input.Position - touchStartPos).Magnitude < 15 then
			shoot()
		end
		isTouching = false
	end
end)

