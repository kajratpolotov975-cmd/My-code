local function playScreenFlash()
	flashFrame.BackgroundTransparency = 1
	local a = TweenService:Create(flashFrame, TweenInfo.new(0.2), {BackgroundTransparency = 0.3})
	a:Play()
	a.Completed:Wait()
	TweenService:Create(flashFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
end

local function playScreenBlur()
	blurFrame.BackgroundTransparency = 1
	TweenService:Create(blurFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0.35
	}):Play()
	for i, circle in ipairs(blurCircles) do
		circle.Size = UDim2.new(0, 100, 0, 100)
		circle.ImageTransparency = 1
		task.spawn(function()
			TweenService:Create(circle, TweenInfo.new(0.5 + i * 0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(3 + i * 0.5, 0, 3 + i * 0.5, 0),
				ImageTransparency = 0.5
			}):Play()
		end)
	end
	task.wait(0.45)
	TweenService:Create(blurFrame, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		BackgroundTransparency = 1
	}):Play()
	for _, circle in ipairs(blurCircles) do
		TweenService:Create(circle, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			ImageTransparency = 1
		}):Play()
	end
end

