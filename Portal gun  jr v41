-- ================= ЗВУК =================
local function playSound(id, pos, vol, pitch)
    local s = Instance.new("Part")
    s.Anchored = true
    s.CanCollide = false
    s.Transparency = 1
    s.Size = Vector3.new(0.1, 0.1, 0.1)
    s.CFrame = CFrame.new(pos)
    s.Parent = workspace
    local sound = Instance.new("Sound")
    sound.SoundId = id
    sound.Volume = vol or 1.5
    sound.PlaybackSpeed = pitch or 1
    sound.Parent = s
    sound:Play()
    sound.Ended:Connect(function() s:Destroy() end)
    task.delay(10, function() if s then s:Destroy() end end)
end

-- ================= SHIFT LOCK (ДЛЯ ТЕЛА) =================
RunService.RenderStepped:Connect(function()
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if shiftLockEnabled then
        hum.AutoRotate = false
        local camDir = Camera.CFrame.LookVector
        local flatDir = Vector3.new(camDir.X, 0, camDir.Z).Unit
        
        if flatDir.Magnitude > 0 then
            local targetCFrame = CFrame.lookAt(hrp.Position, hrp.Position + flatDir)
            hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, 0.3)
        end
    else
        hum.AutoRotate = true
    end
end)

