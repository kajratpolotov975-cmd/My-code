-- ================= ВРАЩЕНИЕ =================
local spinList = {}
RunService.Heartbeat:Connect(function(dt)
    for i, data in ipairs(spinList) do
        if data.portal and data.portal.Parent then
            data.angle = data.angle - math.rad(SPIN_SPEED) * dt 
            data.portal.CFrame = data.baseCF * CFrame.Angles(0, data.angle, 0) * data.rot
        else
            table.remove(spinList, i)
        end
    end
end)

-- ================= ИСКАЖЕНИЕ =================
local function distortOnce()
    for _, p in ipairs(portals) do
        if p and p.Parent then
            spawn(function()
                if not p.Parent then return end
                TweenService:Create(p, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    Size = Vector3.new(PORTAL_SIZE, PORTAL_SIZE * 0.05, PORTAL_SIZE * 0.05) 
                }):Play()
                task.wait(0.2)
                if p and p.Parent then
                    TweenService:Create(p, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                        Size = Vector3.new(PORTAL_SIZE, PORTAL_SIZE, PORTAL_SIZE)
                    }):Play()
                end
            end)
        end
    end
end

-- ================= ТЕЛЕПОРТ =================
local function teleport(entered, exit)
    if teleporting then return end
    teleporting = true

    local c = plr.Character
    if not c then teleporting = false return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then teleporting = false return end

    playSound(SOUND_ENTER, hrp.Position, 1.5)
    screenFlash()
    distortOnce()

    local exitNormal = exit.CFrame.LookVector
    local outPos = exit.Position + exitNormal * 3 + Vector3.new(0, 1, 0)
    local newCF = CFrame.lookAt(outPos, outPos + exitNormal)
    
    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    c:PivotTo(newCF)
    
    task.delay(0.15, function()
        if c and c.Parent then
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
    end)

    hum:ChangeState(Enum.HumanoidStateType.Jumping)
    hrp.AssemblyLinearVelocity = Vector3.new(exitNormal.X * 40, 65, exitNormal.Z * 40)
    
    task.wait(1.5) 
    teleporting = false
end

-- ================= ВЫСТРЕЛ =================
local function fire()
    local c = plr.Character
    if not c then return end
    
    if not weaponHandle or not weaponHandle.Parent or not weaponHandle.Parent:IsA("Tool") then return end
    local isHeld = false
    for _, w in ipairs(c:GetDescendants()) do
        if w:IsA("Weld") and w.Part1 == weaponHandle then isHeld = true break end
    end
    if not isHeld then return end

    local startPos = weaponHandle.Position
    local origin = Camera.CFrame.Position
    local dir = Camera.CFrame.LookVector
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {c}
    for _, p in ipairs(portals) do table.insert(params.FilterDescendantsInstances, p) end

    local direct = workspace:Raycast(origin, dir * MAX_DIST, params)
    local targetPos = direct and direct.Position or (origin + dir * MAX_DIST)

    local ball = Instance.new("Part")
    ball.Shape = Enum.PartType.Ball
    ball.Size = Vector3.new(1.5, 1.5, 1.5)
    ball.Material = Enum.Material.Neon
    ball.Color = BALL_COLOR
    ball.CanCollide = false
    ball.Anchored = true
    ball.CFrame = CFrame.new(startPos)
    ball.Parent = workspace

    local dist = (targetPos - startPos).Magnitude
    local duration = math.max(dist / BALL_SPEED, 0.1)
    local t0 = tick()

    spawn(function()
        while tick() - t0 < duration do
            local t = (tick() - t0) / duration
            ball.CFrame = CFrame.new(startPos:Lerp(targetPos, t))
            RunService.RenderStepped:Wait()
        end

        ball:Destroy()
        if not direct then return end

        if #portals >= MAX_PORTALS then
            local old = table.remove(portals, 1)
            old:Destroy()
        end

        local portal = Instance.new("MeshPart")
        portal.MeshId = PORTAL_MESH
        portal.TextureID = PORTAL_TEXTURE
        portal.Anchored = true
        portal.CanCollide = false
        portal.Material = Enum.Material.Neon
        portal.Color = PORTAL_COLOR
        portal.Transparency = 0
        portal.CanQuery = false
        portal.CanTouch = true

        local up = Vector3.new(0, 1, 0)
        if math.abs(direct.Normal:Dot(up)) > 0.99 then up = Vector3.new(0, 0, 1) end
        local right = direct.Normal:Cross(up).Unit
        local forward = right:Cross(direct.Normal).Unit
        
        local baseCF = CFrame.fromMatrix(direct.Position + direct.Normal * 0.2, right, direct.Normal, forward)
        local rot = CFrame.Angles(math.rad(ROT_X), math.rad(ROT_Y), math.rad(ROT_Z))
        
        portal.CFrame = baseCF * rot
        portal.Parent = workspace
        
        table.insert(portals, portal)
        table.insert(spinList, { portal = portal, baseCF = baseCF, rot = rot, angle = 0 })

        playSound(SOUND_OPEN, direct.Position, 1.5)

        portal.Size = Vector3.new(PORTAL_SIZE, PORTAL_SIZE * 0.1, PORTAL_SIZE * 0.1)
        TweenService:Create(portal, TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
            Size = Vector3.new(PORTAL_SIZE, PORTAL_SIZE, PORTAL_SIZE)
        }):Play()
    end)
end

fireBtn.MouseButton1Click:Connect(fire)

