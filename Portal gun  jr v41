local function setupInventory()
    local backpack = plr:WaitForChild("Backpack")
    local char = plr.Character
    if not char then return end

    for _, v in ipairs(backpack:GetChildren()) do
        if v.Name == TOOL_NAME or v.Name == GLASSES_NAME then v:Destroy() end
    end
    for _, v in ipairs(char:GetChildren()) do
        if v.Name == TOOL_NAME or v.Name == GLASSES_NAME then v:Destroy() end
    end

    -- ПУШКА
    local tool = Instance.new("Tool")
    tool.Name = TOOL_NAME
    tool.RequiresHandle = true
    tool.TextureId = ICON_GUN

    local handle = Instance.new("MeshPart")
    handle.Name = "Handle"
    handle.MeshId = MESH_ID
    handle.TextureID = TEXTURE_ID
    handle.Size = Vector3.new(1, 1, 1)
    handle.CanCollide = false
    handle.Parent = tool
    tool.Parent = backpack

    tool.Equipped:Connect(function() weaponHandle = handle end)
    tool.Unequipped:Connect(function() weaponHandle = nil end)

    -- ОЧКИ
    local glassesTool = Instance.new("Tool")
    glassesTool.Name = GLASSES_NAME
    glassesTool.RequiresHandle = false
    glassesTool.TextureId = ICON_GLASSES
    glassesTool.Parent = backpack

    glassesTool.Equipped:Connect(function() wearBtn.Visible = true end)
    glassesTool.Unequipped:Connect(function() wearBtn.Visible = false end)
end

