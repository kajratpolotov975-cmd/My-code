local function wearGlasses()
    if isEquippedGlasses then return end
    isEquippedGlasses = true
    TweenService:Create(blur, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = 0 }):Play()
    
    local char = plr.Character
    if char then
        local head = char:FindFirstChild("Head")
        if head then
            if head:FindFirstChild("MyGlasses") then head.MyGlasses:Destroy() end
            local g = Instance.new("MeshPart")
            g.Name = "MyGlasses"
            g.MeshId = GLASSES_MESH
            g.TextureID = GLASSES_TEXTURE
            g.Size = Vector3.new(1, 1, 1) 
            g.CanCollide = false
            g.Massless = true
            g.Anchored = true 
            
            g.CFrame = head.CFrame * CFrame.new(0, 0.1, -5) 
            g.Parent = head

            local targetCF = head.CFrame * CFrame.new(0, 0.1, -0.15) * CFrame.Angles(0, math.rad(180), 0)
            TweenService:Create(g, TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = targetCF }):Play()

            task.delay(0.8, function()
                if g and g.Parent then
                    g.Anchored = false
                    local weld = Instance.new("Weld")
                    weld.Part0 = head
                    weld.Part1 = g
                    weld.C0 = CFrame.new(0, 0.1, -0.15) * CFrame.Angles(0, math.rad(180), 0)
                    weld.Parent = g
                end
            end)
        end
    end
end

