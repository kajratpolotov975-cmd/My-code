local function closePortalWithAnim(p)
	if not p or not p.Parent then return end
	local model = p.Parent
	if not model:IsA("Model") then p:Destroy() return end

	local ring
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Part") and d.Shape == Enum.PartType.Cylinder then
			ring = d
			break
		end
	end

	closeSound.TimePosition = 0
	closeSound:Play()

	if ring then
		local info = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		TweenService:Create(ring, info, {
			Size = Vector3.new(0.5, 0.1, 0.1),
			Transparency = 1
		}):Play()
		task.wait(0.35)
	end

	model:Destroy()
end

local function makePortal(pos, norm)
	local model = Instance.new("Model")
	model.Name = "PortalModel"
	model.Parent = workspace

	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.5, 0.1, 0.1)
	ring.Color = Color3.fromRGB(255, 255, 255)
	ring.Material = Enum.Material.SmoothPlastic
	ring.Anchored = true
	ring.CanCollide = false

	local up = Vector3.new(0, 1, 0)
	if math.abs(norm.Y) > 0.95 then up = Vector3.new(0, 0, 1) end
	local baseCF = CFrame.lookAt(pos, pos + norm, up) * CFrame.Angles(0, math.rad(-90), 0)
	ring.CFrame = baseCF
	ring.Parent = model

	for _, face in ipairs({
		Enum.NormalId.Right, Enum.NormalId.Left,
		Enum.NormalId.Top, Enum.NormalId.Bottom,
		Enum.NormalId.Front, Enum.NormalId.Back,
	}) do
		local tex = Instance.new("Texture")
		tex.Face = face
		tex.Texture = "rbxassetid://" .. PORTAL_DECAL
		tex.StudsPerTileU = 7
		tex.StudsPerTileV = 7
		tex.Parent = ring
	end

	local info = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	TweenService:Create(ring, info, { Size = Vector3.new(0.5, 7, 7) }):Play()

	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Cylinder
	core.Size = Vector3.new(1.5, 0.1, 0.1)
	core.Transparency = 1
	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = true
	core.CFrame = baseCF
	core.Parent = model

	TweenService:Create(core, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = Vector3.new(1.5, 6, 6)
	}):Play()

	core:SetAttribute("NX", norm.X)
	core:SetAttribute("NY", norm.Y)
	core:SetAttribute("NZ", norm.Z)

	portalSound.TimePosition = 0
	portalSound:Play()

	local light = Instance.new("PointLight")
	light.Color = C_GREEN
	light.Range = 25
	light.Brightness = 0
	light.Parent = core
	TweenService:Create(light, TweenInfo.new(0.35), {Brightness = 5}):Play()

	return core
end

local function fireBeam(a, b)
	local d = (a - b).Magnitude
	if d < 0.01 then return end
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(d, 0.2, 0.2)
	p.Color = C_BEAM
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.CFrame = CFrame.new(a, b) * CFrame.new(0, 0, -d/2) * CFrame.Angles(0, math.rad(90), 0)
	p.Parent = workspace
	task.spawn(function()
		local t = 0
		while t < 0.15 do
			t += RunService.RenderStepped:Wait()
			p.Transparency = t / 0.15
		end
		p:Destroy()
	end)
end

local function checkTP()
	if isTP then return end
	if os.clock() - tpCD < 1.5 then return end

	local char = LP.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root then return end

	local function inside(p)
		if not p or not p.Parent then return false end
		return (root.Position - p.Position).Magnitude < 4
	end

	local ent, ext
	if portalA and inside(portalA) then ent, ext = portalA, portalB
	elseif portalB and inside(portalB) then ent, ext = portalB, portalA end
	if not ent or not ext or not ext.Parent then return end

	isTP = true
	tpCD = os.clock()

	local s = Instance.new("Sound")
	s.SoundId = S_TP
	s.Volume = 2
	s.PlaybackSpeed = 1.0
	s.Parent = workspace
	s:Play()
	Debris:AddItem(s, 3)

	task.spawn(playScreenFlash)

	local n = Vector3.new(
		ext:GetAttribute("NX") or 0,
		ext:GetAttribute("NY") or 1,
		ext:GetAttribute("NZ") or 0
	)
	local ep = ext.Position

	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end

	local ip = ep + n * 0.5
	local jd = (n + Vector3.new(0, 0.7, 0)).Unit
	root.CFrame = CFrame.new(ip, ip + n)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.AssemblyLinearVelocity = jd * 45 + Vector3.new(0, 22, 0)

	task.spawn(function()
		task.wait(1.2)
		if hum and hum.Parent then
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
			hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
		end
	end)

	task.wait(0.8)
	isTP = false
end

RunService.Heartbeat:Connect(checkTP)

local function shoot()
	if not isGunEquipped() then return end

	if os.clock() - lastShot < 0.3 then return end
	lastShot = os.clock()

	if not cam then cam = workspace.CurrentCamera end
	if not cam then return end

	local origin = cam.CFrame.Position
	local dir = cam.CFrame.LookVector * 1000

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {LP.Character, tool, portalA, portalB}
	local res = workspace:Raycast(origin, dir, params)

	if not res then return end

	local hp = res.Position
	local hn = res.Normal

	if gunSound then
		gunSound.TimePosition = 0
		gunSound:Play()
	end

	if muzzle then
		fireBeam(muzzle.Position, hp)
	end

	local mp = muzzle and muzzle.Position or origin
	local fl = Instance.new("Part")
	fl.Shape = Enum.PartType.Ball
	fl.Size = Vector3.new(0.8, 0.8, 0.8)
	fl.Color = C_ENERGY
	fl.Material = Enum.Material.Neon
	fl.Anchored = true
	fl.CanCollide = false
	fl.CFrame = CFrame.new(mp)
	fl.Parent = workspace

	task.spawn(function()
		local i = TweenInfo.new(0.1)
		TweenService:Create(fl, i, {Size = Vector3.new(0.05, 0.05, 0.05), Transparency = 1}):Play()
		task.wait(0.15)
		fl:Destroy()
	end)

	if nextP == "A" then
		task.spawn(function() if portalA then closePortalWithAnim(portalA) end end)
		portalA = makePortal(hp, hn)
		nextP = "B"
	else
		task.spawn(function() if portalB then closePortalWithAnim(portalB) end end)
		portalB = makePortal(hp, hn)
		nextP = "A"
	end
end

