local function buildGun()
	local t = Instance.new("Tool")
	t.Name = "PortalGun"
	t.RequiresHandle = true
	t.CanBeDropped = false
	t.Grip = BASE_GRIP
	tool = t

	local h = Instance.new("Part")
	h.Name = "Handle"
	h.Size = Vector3.new(0.5, 0.5, 0.5)
	h.Transparency = 1
	h.CanCollide = false
	h.Massless = true
	h.Parent = t
	handle = h

	local meshPart = Instance.new("Part")
	meshPart.Name = "PortalGunMesh"
	meshPart.Size = Vector3.new(1, 1, 1)
	meshPart.Transparency = 0
	meshPart.CanCollide = false
	meshPart.Massless = true
	meshPart.Parent = t

	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = MESH_ID
	mesh.TextureId = TEX_ID
	mesh.Scale = Vector3.new(GUN_SIZE, GUN_SIZE, GUN_SIZE)
	mesh.Parent = meshPart
	meshRef = mesh

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = h
	weld.Part1 = meshPart
	weld.Parent = meshPart

	meshPart.CFrame = h.CFrame * CFrame.new(0, 0, -1)

	muzzle = Instance.new("Part")
	muzzle.Name = "Muzzle"
	muzzle.Size = Vector3.new(0.2, 0.2, 0.2)
	muzzle.Transparency = 1
	muzzle.CanCollide = false
	muzzle.Massless = true
	muzzle.Parent = t
	muzzle.CFrame = h.CFrame * MUZZLE_OFFSET

	local mw = Instance.new("WeldConstraint")
	mw.Part0 = h
	mw.Part1 = muzzle
	mw.Parent = muzzle

	gunSound = Instance.new("Sound")
	gunSound.SoundId = S_SHOOT
	gunSound.Volume = 3
	gunSound.Parent = h

	local gl = Instance.new("PointLight")
	gl.Color = C_GREEN
	gl.Range = 8
	gl.Brightness = 2
	gl.Parent = meshPart

	return t
end

